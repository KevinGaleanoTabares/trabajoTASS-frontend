{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "ecb628a7-4d1e-466e-b13e-4acf76a78c94"
  },
  "newProjectRoot": "projects",
  "projects": {
    "trabajoTASSfrontend": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
               {
                 "glob": "**/*",
                 "input": "src/assets",
                 "output": "assets"
               }
            ],
            "styles": [
              "src/styles.css"
            ],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": []
            },
            "ssr": {
              "entry": "src/server.ts"
            }
          },
          "configurations": {
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true,
              "fileReplacements": [
                {
                  "replace": "src/enviroments/enviroment.ts",
                  "with": "src/enviroments/enviroment.development.ts"
                }
              ]
            },
            "local": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true,
              "fileReplacements": [
                {
                  "replace": "src/enviroments/enviroment.ts",
                  "with": "src/enviroments/enviroment.local.ts"
                }
              ]
            },
            "preprod": {
              "fileReplacements": [
                {
                  "replace": "src/enviroments/enviroment.ts",
                  "with": "src/enviroments/enviroment.preprod.ts"
                }
              ]
            },
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "trabajoTASSfrontend:build:production"
            },
            "development": {
              "buildTarget": "trabajoTASSfrontend:build:development"
            },
            "local": {
              "buildTarget": "trabajoTASSfrontend:build:local"
            },
            "preprod": {
              "buildTarget": "trabajoTASSfrontend:build:preprod"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
